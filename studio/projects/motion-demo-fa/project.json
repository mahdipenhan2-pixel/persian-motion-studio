{
  "meta": {
    "title": "افغانستان در یک نگاه",
    "lang": "fa",
    "format": "9:16",
    "theme": "dark-green",
    "handle": ""
  },
  "voice": {
    "voice": "Kore",
    "style": "calm, clear narration"
  },
  "scenes": [
    {
      "id": "s1",
      "template": "title",
      "narration": "افغانستان کشوری در قلب آسیا است.",
      "on_screen": { "title": "افغانستان", "subtitle": "کشوری در قلب آسیا", "icon": "info" },
      "media": { "src": "assets/hindukush-dusk.png", "frame": "top", "focus": [0.7, 0.55] },
      "camera": { "move": "push-in", "intensity": 0.7 }
    },
    {
      "id": "s2",
      "template": "info",
      "narration": "این کشور با شش کشور همسایه مرز مشترک دارد.",
      "on_screen": { "heading": "شش کشور همسایه", "lines": ["مرز خشکی مشترک", "موقعیتی مهم در منطقه"], "icon": "info" },
      "camera": { "move": "ken-burns", "target": "scene", "intensity": 0.9, "transition_in": { "type": "slide", "duration": 0.4 } }
    },
    {
      "id": "s3",
      "template": "title",
      "narration": "پایتخت افغانستان کابل است و در میان کوه‌های هندوکش قرار دارد.",
      "on_screen": { "title": "کابل", "subtitle": "در میان کوه‌های هندوکش" },
      "media": { "src": "assets/ridges-night.png", "frame": "top", "focus": [0.3, 0.4] },
      "camera": { "move": "ken-burns", "intensity": 0.8, "transition_in": { "type": "wipe", "duration": 0.45 } }
    },
    {
      "id": "s4",
      "template": "steps",
      "narration": "هرات در غرب، قندهار در جنوب و مزار شریف در شمال کشور قرار دارند.",
      "on_screen": {
        "heading": "شهرهای بزرگ",
        "items": [
          { "icon": "info", "text": "هرات · غرب" },
          { "icon": "info", "text": "قندهار · جنوب" },
          { "icon": "info", "text": "مزار شریف · شمال" }
        ]
      },
      "camera": { "move": "pan-start", "target": "scene", "intensity": 0.8, "transition_in": { "type": "zoom-through", "duration": 0.4 } }
    },
    {
      "id": "s5",
      "template": "compare",
      "narration": "این کشور هیچ مرز دریایی ندارد و در خشکی محصور است.",
      "on_screen": {
        "a": { "big": "دریا", "small": "مرز دریایی ندارد", "tone": "warn", "icon": "drop" },
        "b": { "big": "خشکی", "small": "محصور در خشکی", "tone": "ok", "icon": "hand" }
      },
      "media": { "src": "assets/ridges-night.png", "frame": "bottom", "focus": [0.5, 0.5] },
      "camera": { "move": "pan-start", "intensity": 0.8, "transition_in": { "type": "slide", "duration": 0.4 } }
    },
    {
      "id": "s6",
      "template": "cta",
      "narration": "کوهستان‌ها و تاریخ کهن به این سرزمین هویت ویژه‌ای داده‌اند.",
      "on_screen": { "heading": "هویتی کهن", "note": "کوهستان‌ها و تاریخی چند هزار ساله", "icon": "info" },
      "media": { "src": "assets/valley-dawn.png", "frame": "top", "focus": [0.5, 0.45] },
      "camera": { "move": "pull-out", "intensity": 0.7, "ease": "power2.out", "transition_in": { "type": "zoom-through", "duration": 0.35 } }
    }
  ]
}
