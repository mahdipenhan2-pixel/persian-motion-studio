{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfp.cast/1",
  "title": "NFP cast file (one per project)",
  "description": "Characters are project data, not code. Identity is locked by cast.lock.json; scenes may only pick a stage, a wardrobe and an expression. Style-specific vocabularies (builds, hair, outfits, expressions...) come from nfp/character/parts/<style>.json and are checked by registry.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "characters"],
  "properties": {
    "schema": { "const": "nfp.cast/1" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "characters": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": { "$ref": "#/$defs/character" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,23}$" },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "style", "identity", "stages", "wardrobe", "defaults", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "maxLength": 40 },
        "style": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "derived_from": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,39}$" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skin", "hair_color", "eye_color"],
          "properties": {
            "skin": { "$ref": "#/$defs/hex" },
            "hair_color": { "$ref": "#/$defs/hex" },
            "eye_color": { "$ref": "#/$defs/hex" },
            "face": {
              "type": "object", "additionalProperties": false,
              "properties": { "shape": { "type": "string" }, "brows": { "type": "string" }, "nose": { "type": "string" } }
            },
            "marks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "maxItems": 8 }
          }
        },
        "stages": {
          "type": "object", "minProperties": 1, "maxProperties": 12,
          "propertyNames": { "$ref": "#/$defs/slot" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["build", "hair"],
            "properties": { "build": { "type": "string" }, "hair": { "type": "string" } }
          }
        },
        "wardrobe": {
          "type": "object", "minProperties": 1, "maxProperties": 24,
          "propertyNames": { "$ref": "#/$defs/slot" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["outfit", "top"],
            "properties": {
              "outfit": { "type": "string" },
              "top": { "$ref": "#/$defs/hex" },
              "pants": { "$ref": "#/$defs/hex" },
              "shoe": { "$ref": "#/$defs/hex" },
              "shoe_type": { "type": "string" },
              "sleeve": { "type": "string" },
              "legs": { "type": "string" },
              "accent": { "$ref": "#/$defs/hex" },
              "lip": { "$ref": "#/$defs/hex" },
              "accessories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "maxItems": 8 }
            }
          }
        },
        "defaults": {
          "type": "object", "additionalProperties": false, "required": ["stage", "wardrobe", "expr"],
          "properties": { "stage": { "$ref": "#/$defs/slot" }, "wardrobe": { "$ref": "#/$defs/slot" }, "expr": { "type": "string" } }
        },
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["real_person"],
          "properties": {
            "real_person": { "type": "boolean" },
            "depiction": { "enum": ["fictional", "symbolic"] },
            "sources": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 300 }, "maxItems": 20 },
            "notes": { "type": "string", "maxLength": 500 }
          }
        }
      }
    },
    "usage": {
      "description": "How a scene or shot refers to a character. Identity can never be overridden here.",
      "type": "object", "additionalProperties": false, "required": ["character"],
      "properties": {
        "character": { "$ref": "#/$defs/id" },
        "stage": { "$ref": "#/$defs/slot" },
        "wardrobe": { "$ref": "#/$defs/slot" },
        "expr": { "type": "string" }
      }
    }
  }
}
